{
  "dataRoles": [
    {
      "name": "date",
      "kind": "Grouping",
      "displayName": "Date",
      "displayNameKey": "Visual_Date",
      "description": "Date field for the calendar days"
    },
    {
      "name": "mainMeasure",
      "kind": "Measure",
      "displayName": "Main Measure",
      "displayNameKey": "Visual_MainMeasure",
      "description": "The primary measure that colors the heatmap"
    },
    {
      "name": "secondaryMeasures",
      "kind": "Measure",
      "displayName": "Tooltip Measures",
      "displayNameKey": "Visual_SecondaryMeasures",
      "description": "Additional measures shown in the tooltip only"
    },
    {
      "name": "eventName",
      "kind": "Grouping",
      "displayName": "Event Name",
      "displayNameKey": "Visual_EventName",
      "description": "Name of the event"
    },
    {
      "name": "eventCategory",
      "kind": "Grouping",
      "displayName": "Event Category",
      "displayNameKey": "Visual_EventCategory",
      "description": "Category or type of the event (for color coding)"
    },
    {
      "name": "holidayName",
      "kind": "Grouping",
      "displayName": "Holiday Name",
      "displayNameKey": "Visual_HolidayName",
      "description": "Name of the holiday (date comes from the Date field)"
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "date"
              }
            },
            {
              "for": {
                "in": "mainMeasure"
              }
            },
            {
              "for": {
                "in": "secondaryMeasures"
              }
            },
            {
              "for": {
                "in": "eventName"
              }
            },
            {
              "for": {
                "in": "eventCategory"
              }
            },
            {
              "for": {
                "in": "holidayName"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "calendar": {
      "displayName": "Calendar",
      "displayNameKey": "Visual_Calendar",
      "properties": {
        "view": {
          "displayName": "Default View",
          "displayNameKey": "Visual_Calendar_View",
          "type": {
            "enumeration": [
              {
                "value": "year",
                "displayName": "Year [Pro]",
                "displayNameKey": "Visual_Calendar_View_Year"
              },
              {
                "value": "month",
                "displayName": "Month"
              },
              {
                "value": "week",
                "displayName": "Week [Pro]"
              }
            ]
          }
        },
        "monthsToShow": {
          "displayName": "Months to Display [Pro]",
          "displayNameKey": "Visual_Calendar_MonthsToShow",
          "type": {
            "enumeration": [
              {
                "value": "1",
                "displayName": "1 month"
              },
              {
                "value": "2",
                "displayName": "2 months"
              },
              {
                "value": "3",
                "displayName": "3 months"
              },
              {
                "value": "6",
                "displayName": "6 months"
              },
              {
                "value": "12",
                "displayName": "12 months"
              }
            ]
          }
        },
        "fiscalEnabled": {
          "displayName": "Fiscal Calendar",
          "displayNameKey": "Visual_Calendar_FiscalEnabled",
          "type": {
            "bool": true
          }
        },
        "fiscalStartMonth": {
          "displayName": "Fiscal Year Start Month",
          "displayNameKey": "Visual_Calendar_FiscalStartMonth",
          "type": {
            "numeric": true
          }
        },
        "weekStart": {
          "displayName": "Week Starts On",
          "displayNameKey": "Visual_Calendar_WeekStart",
          "type": {
            "enumeration": [
              {
                "value": "0",
                "displayName": "Sunday"
              },
              {
                "value": "1",
                "displayName": "Monday"
              }
            ]
          }
        },
        "weekNumbers": {
          "displayName": "Week Numbers",
          "displayNameKey": "Visual_Calendar_WeekNumbers",
          "type": {
            "enumeration": [
              {
                "value": "none",
                "displayName": "None",
                "displayNameKey": "Visual_Calendar_WeekNumbers_None"
              },
              {
                "value": "iso",
                "displayName": "ISO 8601",
                "displayNameKey": "Visual_Calendar_WeekNumbers_Iso"
              },
              {
                "value": "us",
                "displayName": "US (week of 1 January)",
                "displayNameKey": "Visual_Calendar_WeekNumbers_Us"
              }
            ]
          }
        }
      }
    },
    "heatmap": {
      "displayName": "Heatmap Colors",
      "displayNameKey": "Visual_Heatmap",
      "properties": {
        "colorMin": {
          "displayName": "Min Color",
          "displayNameKey": "Visual_Heatmap_ColorMin",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "colorMax": {
          "displayName": "Max Color",
          "displayNameKey": "Visual_Heatmap_ColorMax",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "colorNull": {
          "displayName": "No Data Color",
          "displayNameKey": "Visual_Heatmap_ColorNull",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "dayColor": {
          "displayName": "Day Color",
          "displayNameKey": "Visual_Heatmap_DayColor",
          "description": "Overrides the heatmap gradient for individual days. Use the fx button to color days by a rule.",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "rule": {
            "inputRole": "mainMeasure",
            "output": {
              "property": "dayColor",
              "selector": [
                "date"
              ]
            }
          }
        }
      }
    },
    "legend": {
