    {
      "name": "holidayName",
      "kind": "Grouping",
      "displayName": "Holiday Name",
      "displayNameKey": "Visual_HolidayName",
      "description": "Name of the holiday (date comes from the Date field)"
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "date"
              }
            },
            {
              "for": {
                "in": "mainMeasure"
              }
            },
            {
              "for": {
                "in": "secondaryMeasures"
              }
            },
            {
              "for": {
                "in": "eventName"
              }
            },
            {
              "for": {
                "in": "eventCategory"
              }
            },
            {
              "for": {
                "in": "holidayName"
              }
            }
          ]
        }
      }
    }
  ],
